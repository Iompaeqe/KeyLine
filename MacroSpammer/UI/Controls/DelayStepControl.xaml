<UserControl x:Class="MacroSpammer.UI.Controls.DelayStepControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Border x:Name="RootBorder"
            Width="54"
            Height="46"
            Margin="7,10,7,10"
            CornerRadius="9"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="27" />
                <RowDefinition Height="1" />
                <RowDefinition Height="18" />
            </Grid.RowDefinitions>

            <TextBox x:Name="ValueTextBox"
                     Grid.Row="0"
                     Background="Transparent"
                     BorderBrush="Transparent"
                     FontSize="16"
                     FontWeight="Bold"
                     FontFamily="Segoe UI"
                     TextAlignment="Center"
                     VerticalContentAlignment="Center"
                     Padding="0"
                     Margin="3,0,3,0"
                     PreviewTextInput="ValueTextBox_PreviewTextInput"
                     GotKeyboardFocus="ValueTextBox_GotKeyboardFocus"
                     LostFocus="ValueTextBox_LostFocus"
                     KeyDown="ValueTextBox_KeyDown" />

            <Border x:Name="Divider"
                    Grid.Row="1"
                    Height="1"
                    Margin="9,0,9,0" />

            <TextBlock x:Name="UnitTextBlock"
                       Grid.Row="2"
                       FontSize="10"
                       FontFamily="Segoe UI"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
