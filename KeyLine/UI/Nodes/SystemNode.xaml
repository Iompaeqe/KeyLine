<local:NodeBase x:Class="KeyLine.UI.Nodes.SystemNode"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KeyLine.UI.Nodes"
             Focusable="False">
    <Border x:Name="RootBorder"
            Height="50"
            MinWidth="112"
            MaxWidth="168"
            Margin="5,0,5,0"
            CornerRadius="10"
            Padding="8,5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="ActionTextBlock"
                       Grid.Row="0"
                       FontSize="10"
                       FontWeight="Bold"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock x:Name="DetailTextBlock"
                       Grid.Row="1"
                       FontSize="10"
                       FontWeight="SemiBold"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</local:NodeBase>
