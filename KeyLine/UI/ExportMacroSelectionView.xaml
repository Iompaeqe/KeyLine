<UserControl x:Class="KeyLine.ExportMacroSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border Width="360"
            Height="330"
            CornerRadius="12"
            Background="#121A27"
            BorderBrush="#2A3B55"
            BorderThickness="1"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleTextBlock"
                       Text="Export macros"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#E5EEF8"
                       Margin="0,0,0,10" />

            <ListBox x:Name="MacroListBox"
                     Grid.Row="1"
                     SelectionMode="Multiple"
                     DisplayMemberPath="Name"
                     Background="#0B1220"
                     BorderBrush="#2A3B55"
                     Foreground="#E5EEF8" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="Cancel"
                        Width="82"
                        Height="26"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click" />
                <Button Content="Export"
                        Width="82"
                        Height="26"
                        Background="#123A5A"
                        BorderBrush="#256D9D"
                        Foreground="#BAE6FD"
                        Click="ExportButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
