<Window x:Class="KeyLine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:KeyLine.UI"
        xmlns:controls="clr-namespace:KeyLine.UI.MainWindow.Controls"
        xmlns:entryBlocks="clr-namespace:KeyLine.UI.Common.EntryBlocks"
        Title="KeyLine"
        Icon="/Assets/AppIcon.ico"
        Width="900" Height="420"
        MinWidth="900" MinHeight="420" MaxHeight="420"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Focusable="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        Drop="Window_Drop">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Common/Styles/Colors.xaml" />
                <ResourceDictionary Source="../Common/Styles/TextBlocks.xaml" />
                <ResourceDictionary Source="../Common/Styles/Buttons.xaml" />
                <ResourceDictionary Source="../Common/Styles/TextBoxes.xaml" />
                <ResourceDictionary Source="../Common/Styles/CheckBoxes.xaml" />
                <ResourceDictionary Source="../Common/Styles/ScrollBars.xaml" />
                <ResourceDictionary Source="../Common/Styles/ComboBoxes.xaml" />
                <ResourceDictionary Source="../Common/Styles/ContextMenus.xaml" />
                <ResourceDictionary Source="../Common/Styles/ToolTips.xaml" />
                <ResourceDictionary Source="../Common/Styles/Options.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PlaybackLeftHalfButton" TargetType="Button">
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Border x:Name="B"
                                        CornerRadius="7,0,0,7"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" />
                                <Border x:Name="HoverOverlay"
                                        CornerRadius="7,0,0,7"
                                        Background="#FFFFFF"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.08" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.14" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PlaybackRightHalfButton" TargetType="Button">
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Border x:Name="B"
                                        CornerRadius="0,7,7,0"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" />
                                <Border x:Name="HoverOverlay"
                                        CornerRadius="0,7,7,0"
                                        Background="#FFFFFF"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.08" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.14" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="WindowRoot"
          Background="Transparent">
        
        <Border Margin="8"
                CornerRadius="14"
                Background="{StaticResource Bg}"
                BorderBrush="#2A3547"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="0"
                                  Opacity="0.45"
                                  Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="96" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <!-- ── Title bar ───────────────────────────────────── -->
                <Grid Grid.Row="0"
                      Margin="14,0"
                      Background="Transparent"
                      Panel.ZIndex="1000"
                      PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:AppTitleBlock x:Name="AppTitleBlock" Grid.Column="0" />

                    <controls:ProfileDropdownBlock x:Name="ProfileDropdownBlock" Grid.Column="1" Margin="10,0,0,0" />

                    <controls:MacroTabsBlock x:Name="MacroTabsBlock" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1001" />

                    <entryBlocks:OptionsPillBlock x:Name="GlobalRemapPill" Grid.Column="3" Padding="0,7,0,0" Text="Remaps: off"/>

                    <controls:TitleCommandButtons x:Name="TitleCommandButtons" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <Border Grid.ColumnSpan="5" Height="1" VerticalAlignment="Bottom" Margin="-14,0" Background="#263244" />
                </Grid>

                <!-- ── Config strip ────────────────────────────────── -->
                <Grid Grid.Row="1" Margin="14,8,14,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Window selector -->
                    <controls:TargetWindowPanel x:Name="TargetWindowPanel" Grid.Column="0" />

                    <controls:MacroOptionsPanel x:Name="MacroOptionsPanel" Grid.Column="2" />
                </Grid>

                <!-- ── Timeline ────────────────────────────────────── -->
                <Border Grid.Row="2" Margin="14,0,14,6" CornerRadius="10"
                        Background="#0F141D" BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <Grid x:Name="TimelineGrid"
                          ClipToBounds="True"
                          PreviewMouseLeftButtonDown="TimelineGrid_PreviewMouseLeftButtonDown"
                          PreviewMouseDown="TimelineGrid_PreviewMouseDown"
                          PreviewMouseMove="TimelineGrid_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="TimelineGrid_PreviewMouseLeftButtonUp"
                          PreviewMouseUp="TimelineGrid_PreviewMouseUp"
                          MouseLeave="TimelineGrid_MouseLeave">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="TimelineHeaderColumn" Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: timeline header cards. Lives in row 1 (the content row) so the
                             cards share the same vertical origin as the scrollable node rows. -->
                        <Grid x:Name="TimelineHeaderGrid"
                              Grid.Row="1"
                              Grid.Column="0"
                              Background="Transparent" />

                        <!-- Column 1 / Row 0: title belongs to the timeline content side -->
                        <DockPanel Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="12,5,12,0">
                            <TextBlock Text="TIMELINES" Style="{StaticResource Cap}"
                                       Margin="0" DockPanel.Dock="Left" />
                            <TextBlock Text="drag to reorder  ·  right-click to remove  ·  double-click to open inspector"
                                       Style="{StaticResource Dim}" FontSize="10"
                                       HorizontalAlignment="Right" />
                        </DockPanel>

                        <!-- Column 1 / Row 1: scrollable timeline content -->
                        <ScrollViewer x:Name="TimelineScrollViewer"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      Padding="16,0,10,16"
                                      Background="Transparent"
                                      Loaded="TimelineScrollViewer_Loaded"
                                      ScrollChanged="TimelineScrollViewer_ScrollChanged"
                                      SizeChanged="TimelineScrollViewer_SizeChanged"
                                      PreviewMouseWheel="TimelineScrollViewer_PreviewMouseWheel">

                            <StackPanel x:Name="TimelineRowsPanel"
                                        Orientation="Vertical"
                                        Background="Transparent" />
                        </ScrollViewer>

                        <Border x:Name="RecordingMouseNotice"
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,-15,0,0"
                                Padding="10,4"
                                CornerRadius="8"
                                Background="#2A0808"
                                BorderBrush="#7F1D1D"
                                BorderThickness="1"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Panel.ZIndex="80">
                            <TextBlock Text="Recording: click or scroll this timeline area to add mouse input"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#FCA5A5" />
                        </Border>


                        <Grid x:Name="EmptyTimelinePanel"
                              Grid.Row="0"
                              Grid.RowSpan="2"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Visibility="Collapsed"
                              Background="Transparent"
                              Panel.ZIndex="50">
                            <Button Content="＋"
                                    Width="72"
                                    Height="32"
                                    Margin="33,0,0,16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Click="AddTimelineButton_Click" />
                        </Grid>

                        <!-- Drag overlay only over scrollable node area -->
                        <Canvas x:Name="TimelineDragOverlayCanvas"
                                Grid.Row="1"
                                Grid.Column="1"
                                IsHitTestVisible="False"
                                ClipToBounds="False"
                                Panel.ZIndex="999" />

                        <!-- Scroll indicator only under node area, not header column -->
                        <Canvas x:Name="TimelineScrollIndicator"
                                Grid.Row="1"
                                Grid.Column="1"
                                Height="10"
                                VerticalAlignment="Bottom"
                                Margin="16,0,14,5"
                                IsHitTestVisible="False">

                            <Border x:Name="TimelineScrollTrack"
                                    Canvas.Left="0"
                                    Canvas.Top="3"
                                    Height="4"
                                    CornerRadius="2"
                                    Background="#334155"
                                    Opacity="0.55" />

                            <Border x:Name="TimelineScrollThumb"
                                    Canvas.Left="0"
                                    Canvas.Top="3"
                                    Height="4"
                                    CornerRadius="2"
                                    Background="#94A3B8"
                                    Opacity="0.95" />
                        </Canvas>

                        <TextBlock x:Name="SingleTimelineMetadataText"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Bottom"
                                   Margin="16,0,0,15"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}"
                                   Opacity="0.82"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"
                                   Panel.ZIndex="20" />
                    </Grid>
                </Border>

                <!-- ── Control bar ─────────────────────────────────── -->
                <Border Grid.Row="3" Margin="14,0,14,6" Padding="12,0" CornerRadius="10"
                        Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="AddTimelineButton" Content="＋ Timeline" Width="96"
                                Background="#123A5A" BorderBrush="#256D9D"
                                Foreground="#BAE6FD"
                                ToolTip="{x:Static ui:TooltipNotes.AddTimeline}"
                                Click="AddTimelineButton_Click" />

                        <TextBlock x:Name="StatusText" Grid.Column="2"
                                   Text="Stopped" Style="{StaticResource Dim}" />

                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Timer"
                                       Style="{StaticResource Dim}"
                                       ToolTip="{x:Static ui:TooltipNotes.MacroTimer}"
                                       Margin="0,0,8,0" />
                            <Grid Width="64" ToolTip="{x:Static ui:TooltipNotes.MacroTimer}">
                                <TextBox x:Name="TimerMinutesTextBox"
                                         Text="0"
                                         Padding="2,0,11,0"
                                         PreviewTextInput="DelayInputTextBox_PreviewTextInput"
                                         GotKeyboardFocus="DelayInputTextBox_GotKeyboardFocus"
                                         LostFocus="DelayInputTextBox_LostFocus"
                                         KeyDown="DelayInputTextBox_KeyDown" />
                                <TextBlock x:Name="TimerUnitTextBlock"
                                           Text="ms"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" 
                                           Margin="0,0,5,0"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Muted}"
                                           IsHitTestVisible="False" />
                            </Grid>
                            <Button x:Name="ClearButton"
                                    Content="Clear"
                                    Width="92"
                                    Margin="10,0,0,0"
                                    ToolTip="{x:Static ui:TooltipNotes.ClearSelection}"
                                    Click="ClearButton_Click" />

                            <Grid Width="154"
                                  Height="30"
                                  Margin="8,0,0,0">
                                <Button x:Name="StartStopButton"
                                        Content="▶  Start"
                                        Background="#31205F"
                                        BorderBrush="#6D4AFF"
                                        Foreground="#DDD6FE"
                                        Panel.ZIndex="10"
                                        ToolTip="{x:Static ui:TooltipNotes.StartPlayback}"
                                        Click="StartStopButton_Click" />

                                <Grid x:Name="PlaybackSplitButton"
                                      Panel.ZIndex="30"
                                      Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="PauseResumeButton"
                                            Grid.Column="0"
                                            Content="Pause"
                                            Style="{StaticResource PlaybackLeftHalfButton}"
                                            Background="#3B2A05"
                                            BorderBrush="#B45309"
                                            BorderThickness="1"
                                            Foreground="#FDE68A"
                                            Visibility="Visible"
                                            ToolTip="{x:Static ui:TooltipNotes.PauseResumePlayback}"
                                            Click="PauseResumeButton_Click" />

                                    <Border Grid.Column="1"
                                            Background="#10151D"
                                            Opacity="0.95" />

                                    <Button x:Name="StopPlaybackButton"
                                            Grid.Column="2"
                                            Content="Stop"
                                            Style="{StaticResource PlaybackRightHalfButton}"
                                            Background="#3A0A0A"
                                            BorderBrush="#B91C1C"
                                            BorderThickness="1"
                                            Foreground="#FCA5A5"
                                            Visibility="Visible"
                                            ToolTip="{x:Static ui:TooltipNotes.StopPlayback}"
                                            Click="StopPlaybackButton_Click" />
                                </Grid>

                                <Grid x:Name="RecordStopButtonHost"
                                      Panel.ZIndex="40"
                                      IsHitTestVisible="False"
                                      Visibility="Collapsed">
                                    <Button x:Name="RecordStopButton"
                                            Content="◼  Stop Rec"
                                            Background="#2A0808"
                                            BorderBrush="#7F1D1D"
                                            Foreground="#FCA5A5"
                                            Click="RecordStopButton_Click" />
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <controls:TimelineAddMenuView x:Name="TimelineAddMenu" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="SettingsModalOverlay"
              Visibility="Collapsed"
              Background="Transparent"
              Panel.ZIndex="2000">
            <Border Margin="8"
                    CornerRadius="14"
                    Background="#AA020617">
                <ContentControl x:Name="SettingsModalHost"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</Window>
