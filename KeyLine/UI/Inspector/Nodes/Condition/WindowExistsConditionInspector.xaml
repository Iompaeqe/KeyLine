<UserControl x:Class="KeyLine.UI.Inspector.Nodes.WindowExistsConditionInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:KeyLine.UI.Common.Layout">

    <Border Background="{StaticResource Surface}">
        <StackPanel>
            <layout:InspectorRow x:Name="WindowSourceRow"
                                 Label="Window Source"
                                 RowToolTip="Window source to check for existence.">
                <ComboBox Width="120"
                          Height="24"
                          Padding="-5,0,-5,0"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          ToolTip="Window source to check for existence." />
            </layout:InspectorRow>

            <StackPanel x:Name="CustomTitlePanel"
                        Margin="0,4,0,0"
                        ToolTip="Partial window title to match. Matching uses the same contains behavior as AutoTarget.">

                <TextBlock Text="Title contains"
                           Style="{DynamicResource InspectorLabel}"
                           Margin="0,0,0,5" />

                <TextBox x:Name="CustomTitleTextBox"
                         Height="24"
                         ToolTip="Partial window title to match." />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>