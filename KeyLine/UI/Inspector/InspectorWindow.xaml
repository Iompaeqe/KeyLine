<Window x:Class="KeyLine.UI.Inspector.InspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:KeyLine.UI"
        xmlns:entryBlocks="clr-namespace:KeyLine.UI.Common.EntryBlocks"
        xmlns:layout="clr-namespace:KeyLine.UI.Common.Layout"
        Title="Inspector"
        Width="242"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Single inspector-owned dictionary: shared brushes + inspector input/field styles. -->
                <ResourceDictionary Source="Styles/Inspector.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="0,8,8,0" Margin="0,8,8,8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" Color="#000000" />
        </Border.Effect>

        <Grid>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="InspectorFocusSink" Width="1" Height="1" Opacity="0" Focusable="True" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />

            <!-- INSPECTOR -->
            <Border Grid.Row="0" Background="#1A2433" Padding="10,6" CornerRadius="0,7,0,0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <TextBlock Text="INSPECTOR" Style="{StaticResource Cap}" Margin="0" HorizontalAlignment="Left" />
            </Border>

            <ScrollViewer x:Name="InspectorScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="0,0,3,0" CanContentScroll="False">
                <StackPanel x:Name="InspectorContentPanel" Margin="8,6,4,6">
                    <StackPanel x:Name="TimelineSectionHost" Margin="0,0,0,7">
                        <!-- TIMELINE Header -->
                        <layout:InspectorSectionHeader x:Name="TimelineHeader" Header="TIMELINE" ArrowText="▼" HeaderToolTip="{x:Static ui:TooltipNotes.TimelineSectionToggle}" />

                        <StackPanel x:Name="TimelineContentPanel">
                            <!-- Name Field -->
                            <layout:InspectorRow x:Name="TimelineNameRow" Label="Name" RowToolTip="{x:Static ui:TooltipNotes.RenameTimeline}">
                                <entryBlocks:NameEntryBlock ToolTip="{x:Static ui:TooltipNotes.EditTimelineName}" />
                            </layout:InspectorRow>

                            <!-- PLAYBACK Header -->
                            <TextBlock Text="PLAYBACK" Style="{StaticResource InspectorGroupLabel}" />

                            <!-- Loops Field -->
                            <layout:InspectorRow x:Name="TimelineLoopsRow" Label="Loops" RowToolTip="{x:Static ui:TooltipNotes.TimelineLoops}">
                                <entryBlocks:NumberEntryBlock ToolTip="{x:Static ui:TooltipNotes.TimelineLoops}" />
                            </layout:InspectorRow>

                            <!-- Loop delay Field -->
                            <layout:InspectorRow x:Name="TimelineLoopDelayRow" Label="Loop Delay" RowToolTip="{x:Static ui:TooltipNotes.TimelineLoopDelay}">
                                <entryBlocks:TimeEntryBlock ToolTip="{x:Static ui:TooltipNotes.TimelineLoopDelayEdit}" />
                            </layout:InspectorRow>

                            <!-- Cooldown Field (Sequence/Random only) -->
                            <layout:InspectorRow x:Name="TimelineCooldownRow" Label="Cooldown" RowToolTip="Cooldown before this timeline can be picked again by Sequence/Random.">
                                <entryBlocks:TimeEntryBlock ToolTip="Cooldown before this timeline can be picked again by Sequence/Random." />
                            </layout:InspectorRow>

                            <!-- INPUT Header -->
                            <TextBlock Text="INPUT" Style="{StaticResource InspectorGroupLabel}" />

                            <!-- Input Type Field -->
                            <layout:InspectorRow x:Name="InputTypeRow" Label="Input Type" RowToolTip="{x:Static ui:TooltipNotes.TimelineInputType}">
                                <entryBlocks:PagerEntryBlock ToolTip="{x:Static ui:TooltipNotes.TimelineInputType}" />
                            </layout:InspectorRow>

                            <!-- Standard Dlay Field -->
                            <layout:InspectorRow x:Name="TimelineStandardDelayRow" Label="Standard Delay" RowToolTip="{x:Static ui:TooltipNotes.TimelineStandardDelay}">
                                <CheckBox VerticalAlignment="Center" ToolTip="{x:Static ui:TooltipNotes.TimelineStandardDelay}" />
                            </layout:InspectorRow>

                            <StackPanel x:Name="StandardDelayDetailsPanel" Margin="8,0,0,0">
                                <!-- Delay Field -->
                                <layout:InspectorRow x:Name="TimelineStandardDelayValueRow" Label="Delay" RowMargin="7,0,0,2" RowToolTip="{x:Static ui:TooltipNotes.TimelineStandardDelayValue}">
                                    <entryBlocks:TimeEntryBlock ToolTip="{x:Static ui:TooltipNotes.TimelineStandardDelayEdit}" />
                                </layout:InspectorRow>

                                <!-- Key Up/Down Field -->
                                <layout:InspectorRow x:Name="TimelineShowKeyUpDownRow" Label="Key Up/Down" RowMargin="7,0,0,2" RowToolTip="{x:Static ui:TooltipNotes.TimelineShowKeyUpDown}">
                                    <CheckBox VerticalAlignment="Center" ToolTip="{x:Static ui:TooltipNotes.TimelineShowKeyUpDown}" />
                                </layout:InspectorRow>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Margin="0,-5,0,5" Background="#263244" Opacity="0.8" />

                    <StackPanel x:Name="NodeSectionHost" Margin="0,0,0,7">
                        <!-- NODE Header -->
                        <layout:InspectorSectionHeader x:Name="NodeHeader" Header="NODE" ArrowText="▼" HeaderToolTip="{x:Static ui:TooltipNotes.NodeSectionToggle}" />

                        <StackPanel x:Name="NodeContentPanel" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
