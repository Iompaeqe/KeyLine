<UserControl x:Class="KeyLine.UI.Inspector.Nodes.RepeatBlockInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:KeyLine.UI"
             xmlns:layout="clr-namespace:KeyLine.UI.Common.Layout"
             xmlns:entryBlocks="clr-namespace:KeyLine.UI.Common.EntryBlocks">

    <Border Background="{StaticResource Surface}">
        <StackPanel>
            <layout:InspectorRow Label="Type">
                <TextBlock Text="Repeat Block"
                           Style="{DynamicResource InspectorValue}" />
            </layout:InspectorRow>

            <layout:InspectorRow x:Name="CountRow"
                                 Label="Count"
                                 RowToolTip="{x:Static ui:TooltipNotes.RepeatCount}">
                <entryBlocks:NumberEntryBlock HorizontalAlignment="Right"
                                              ToolTip="{x:Static ui:TooltipNotes.RepeatCount}" />
            </layout:InspectorRow>

            <layout:InspectorRow x:Name="InsideRow"
                                 Label="Inside">
                <TextBlock Style="{DynamicResource InspectorValue}" />
            </layout:InspectorRow>
        </StackPanel>
    </Border>
</UserControl>