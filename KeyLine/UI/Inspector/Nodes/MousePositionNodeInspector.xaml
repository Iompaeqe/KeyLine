<UserControl x:Class="KeyLine.UI.Inspector.Nodes.MousePositionNodeInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:KeyLine.UI"
             xmlns:layout="clr-namespace:KeyLine.UI.Common.Layout"
             xmlns:entryBlocks="clr-namespace:KeyLine.UI.Common.EntryBlocks">

    <Border Background="{StaticResource Surface}">
        <StackPanel>
            <layout:InspectorRow x:Name="XRow"
                                 Label="X"
                                 RowToolTip="Window-relative X coordinate.">
                <entryBlocks:NumberEntryBlock HorizontalAlignment="Right"
                                              ToolTip="Window-relative X coordinate." />
            </layout:InspectorRow>

            <layout:InspectorRow x:Name="YRow"
                                 Label="Y"
                                 RowToolTip="Window-relative Y coordinate.">
                <entryBlocks:NumberEntryBlock HorizontalAlignment="Right"
                                              ToolTip="Window-relative Y coordinate." />
            </layout:InspectorRow>

            <Button x:Name="PickPointButton"
                    Content="Pick point"
                    Height="22"
                    Margin="0,2,0,0"
                    ToolTip="{x:Static ui:TooltipNotes.PickMouseCoordinates}" />
        </StackPanel>
    </Border>
</UserControl>