<UserControl x:Class="KeyLine.UI.Inspector.Nodes.KeyToggleNodeInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:KeyLine.UI.Common.Layout">

    <Border Background="{StaticResource Surface}">
        <StackPanel>
            <layout:InspectorRow x:Name="KeyRow"
                                 Label="Key">
                <TextBlock TextWrapping="Wrap"
                           Style="{DynamicResource InspectorValue}" />
            </layout:InspectorRow>

            <layout:InspectorRow x:Name="ToggleModeRow"
                                 Label="Toggle Mode"
                                 RowToolTip="How this recorded togkgle key changes the OS toggle state.">
                <ComboBox Width="120"
                          Height="24"
                          Padding="-5,0,-5,0"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          ToolTip="How this recorded toggle key changes the OS toggle state." />
            </layout:InspectorRow>
        </StackPanel>
    </Border>
</UserControl>