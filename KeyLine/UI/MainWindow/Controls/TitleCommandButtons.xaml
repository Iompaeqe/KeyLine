<UserControl x:Class="KeyLine.UI.MainWindow.Controls.TitleCommandButtons"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:KeyLine.UI"
             MinWidth="130"
             Height="36">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Common/Styles/ControlPreviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource Bg}"
            Padding="4,0">

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

            <Button x:Name="ToggleRightPanelButton"
                    Content="◫"
                    Style="{StaticResource TitleGlyphButton}"
                    ToolTip="{x:Static ui:TooltipNotes.ToggleInspector}" />

            <Grid Width="30"
                  Height="22">
                <Button x:Name="SettingsButton"
                        Content="&#x2699;"
                        Style="{StaticResource TitleGlyphButton}"
                        ToolTip="{x:Static ui:TooltipNotes.OpenSettings}" />

                <Border x:Name="SettingsUpdateBadge"
                        Width="12"
                        Height="12"
                        CornerRadius="6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-3,-2,0"
                        Background="#F59E0B"
                        BorderBrush="#FEF3C7"
                        BorderThickness="1"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <TextBlock Text="!"
                               FontFamily="Segoe UI"
                               FontSize="8"
                               FontWeight="Black"
                               Foreground="#111827"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-1,0,0" />
                </Border>
            </Grid>

            <Button x:Name="MinimizeButton"
                    Content="─"
                    Style="{StaticResource TitleGlyphButton}" />

            <Button x:Name="CloseWindowButton"
                    Content="×"
                    Style="{StaticResource TitleCloseGlyphButton}" />

        </StackPanel>
    </Border>
</UserControl>
