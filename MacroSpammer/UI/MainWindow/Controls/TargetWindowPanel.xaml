<UserControl x:Class="MacroSpammer.UI.MainWindow.Controls.TargetWindowPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MacroSpammer.UI"
             xmlns:entryBlocks="clr-namespace:MacroSpammer.UI.Common.EntryBlocks"
             Width="400"
             HorizontalAlignment="Left"
             VerticalAlignment="Top">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Common/Styles/ControlPreviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TargetWindowSearchPillBorder"
                   TargetType="Border"
                   BasedOn="{StaticResource OptionsShortcutBorder}">
                <Setter Property="Margin" Value="6,0,0,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#10151D">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="28" />
                <RowDefinition Height="0" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="0,-5,0,0">

                <TextBlock Text="TARGET WINDOW"
                           Padding="0,4,0,0"
                           Style="{StaticResource Cap}"
                           VerticalAlignment="Center" />
                

                <entryBlocks:OptionsPillBlock x:Name="TargetWindowSearchPill"
                                              BorderStyle="{StaticResource TargetWindowSearchPillBorder}"
                                              InputWidth="92"
                                              PlaceholderText="auto target"
                                              ToolTip="{x:Static ui:TooltipNotes.TargetWindowSearchName}" />
            </StackPanel>

            <ComboBox x:Name="WindowComboBox"
                      Grid.Row="1"
                      Width="400"
                      ToolTip="{x:Static ui:TooltipNotes.TargetTopLevelWindow}" />

            <ComboBox x:Name="HandleComboBox"
                      Grid.Row="3"
                      Width="400"
                      ToolTip="{x:Static ui:TooltipNotes.TargetChildWindow}"
                      Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
