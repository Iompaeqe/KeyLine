<UserControl x:Class="MacroSpammer.UI.Common.EntryBlocks.PagerEntryBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="PagerGlyph" TargetType="TextBlock">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#8EA0B6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, ElementName=Root}" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="Opacity" Value="0.35" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                ToolTip="{Binding ToolTip, ElementName=Root}">
        <TextBlock x:Name="PreviousTextBlock"
                   Text="&lt;"
                   Style="{StaticResource PagerGlyph}" />
        <TextBlock x:Name="ValueTextBlock"
                   MinWidth="{Binding ValueMinWidth, ElementName=Root}"
                   Height="20"
                   Padding="0,2,0,0"
                   Text="{Binding Text, ElementName=Root}"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="#E2E8F0"
                   Cursor="Hand"
                   ToolTip="{Binding ToolTip, ElementName=Root}" />
        <TextBlock x:Name="NextTextBlock"
                   Text="&gt;"
                   Style="{StaticResource PagerGlyph}" />
    </StackPanel>
</UserControl>
