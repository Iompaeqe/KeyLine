<UserControl x:Class="KeyLine.UI.Inspector.Nodes.RunMacroNodeInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:KeyLine.UI.Common.Layout">

    <Border Background="{StaticResource Surface}">
        <StackPanel>
            <layout:InspectorRow x:Name="MacroRow"
                                 Label="Macro"
                                 RowToolTip="Macro from the active profile to run.">
                <ComboBox Width="120"
                          Height="24"
                          Padding="-5,0,-5,0"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          ToolTip="Macro from the active profile to run." />
            </layout:InspectorRow>
        </StackPanel>
    </Border>
</UserControl>