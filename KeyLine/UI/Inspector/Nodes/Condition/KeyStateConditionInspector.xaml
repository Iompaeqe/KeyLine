<UserControl x:Class="KeyLine.UI.Inspector.Nodes.KeyStateConditionInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:KeyLine.UI"
             xmlns:layout="clr-namespace:KeyLine.UI.Common.Layout"
             xmlns:entryBlocks="clr-namespace:KeyLine.UI.Common.EntryBlocks">

    <Border Background="{StaticResource Surface}">
        <StackPanel>
            <layout:InspectorRow x:Name="InputRow"
                                 Label="Input"
                                 RowToolTip="{x:Static ui:TooltipNotes.ConditionKeyState}">
                <entryBlocks:OptionsPillBlock PlaceholderText="press input"
                                              HorizontalAlignment="Right"
                                              Focusable="True"
                                              ToolTip="{x:Static ui:TooltipNotes.ConditionKeyState}" />
            </layout:InspectorRow>
        </StackPanel>
    </Border>
</UserControl>