<UserControl x:Class="KeyLine.UI.Common.Layout.InspectorSectionHeader"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="18"
             Margin="{Binding HeaderMargin, ElementName=Root}"
             Cursor="Hand"
             Background="Transparent"
             ToolTip="{Binding HeaderToolTip, ElementName=Root}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding Header, ElementName=Root}"
                   Style="{DynamicResource Cap}"
                   Margin="0" />

        <TextBlock Grid.Column="1"
                   Text="{Binding ArrowText, ElementName=Root}"
                   Foreground="#8EA0B6"
                   FontSize="10"
                   FontWeight="Bold"
                   Margin="5,-3,0,0"
                   VerticalAlignment="Center" />
    </Grid>
</UserControl>