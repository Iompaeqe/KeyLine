<UserControl x:Class="MacroSpammer.UI.Common.EntryBlocks.OptionsPillBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="True">

    <Border x:Name="PillBorder"
            Style="{Binding BorderStyle, ElementName=Root}"
            ToolTip="{Binding ToolTip, ElementName=Root}">

        <Grid>
            <TextBlock x:Name="DisplayTextBlock"
                       Text="{Binding DisplayText, ElementName=Root}"
                       Style="{Binding TextStyle, ElementName=Root}"
                       Focusable="False" />

            <TextBox x:Name="InputTextBox"
                     Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                     Style="{Binding TextBoxStyle, ElementName=Root}"
                     Width="{Binding InputWidth, ElementName=Root}"
                     Visibility="Collapsed" />

            <TextBlock x:Name="PlaceholderTextBlock"
                       Text="{Binding PlaceholderText, ElementName=Root}"
                       Style="{Binding PlaceholderStyle, ElementName=Root}"
                       Width="{Binding InputWidth, ElementName=Root}"
                       Visibility="Collapsed"
                       IsHitTestVisible="False" />
        </Grid>
    </Border>
</UserControl>
