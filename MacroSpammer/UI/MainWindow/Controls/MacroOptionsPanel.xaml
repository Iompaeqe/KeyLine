<UserControl x:Class="MacroSpammer.UI.MainWindow.Controls.MacroOptionsPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MacroSpammer.UI"
             xmlns:entryBlocks="clr-namespace:MacroSpammer.UI.Common.EntryBlocks">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Common/Styles/ControlPreviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Border Style="{DynamicResource OptionsPanelBorder}">
        <StackPanel>
            <Grid Style="{DynamicResource OptionsHeaderGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">

                    <TextBlock Text="OPTIONS"
                               Style="{DynamicResource Cap}"
                               Margin="0" />

                    <entryBlocks:OptionsPillBlock x:Name="ShortcutPill"
                                                  Text="no shortcut"
                                                  ToolTip="{x:Static ui:TooltipNotes.MacroShortcutCapture}"
                                                  Focusable="True" />

                    <entryBlocks:OptionsPillBlock x:Name="ShortcutTogglePill"
                                                  Text="on"
                                                  ToolTip="{x:Static ui:TooltipNotes.MacroShortcutToggle}" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,0">

                    <TextBlock Text="Loop Type"
                               Style="{StaticResource Dim}"
                               Margin="0,0,6,0">

                        <TextBlock.ToolTip>
                            <TextBlock>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopType}"/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopTypeAsync}"/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopTypeSync}"/>
                            </TextBlock>
                        </TextBlock.ToolTip>
                    </TextBlock>

                    <entryBlocks:PagerEntryBlock x:Name="LoopTypePager"
                                                 ValueMinWidth="42"
                                                 ToolTip="{x:Static ui:TooltipNotes.MacroLoopType}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>