<local:NodeBase x:Class="KeyLine.UI.Nodes.DelayNode"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KeyLine.UI.Nodes"
             Focusable="False">
    <Border x:Name="RootBorder"
            Height="46"
            Margin="7,10,7,10"
            CornerRadius="9"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="27" />
                <RowDefinition Height="1" />
                <RowDefinition Height="18" />
            </Grid.RowDefinitions>

            <Grid x:Name="FixedDelayPanel"
                  Grid.Row="0">
                <TextBox x:Name="ValueTextBox"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         FontSize="16"
                         FontWeight="Bold"
                         FontFamily="Segoe UI"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         BorderThickness="0"
                         IsReadOnly="False"
                         Focusable="True"
                         IsHitTestVisible="True"
                         Padding="0"
                         Margin="3,0,3,0"
                         PreviewTextInput="ValueTextBox_PreviewTextInput"
                         GotKeyboardFocus="ValueTextBox_GotKeyboardFocus"
                         LostFocus="ValueTextBox_LostFocus"
                         TextChanged="ValueTextBox_TextChanged"
                         KeyDown="ValueTextBox_KeyDown" />
            </Grid>

            <Grid x:Name="RandomDelayPanel"
                  Grid.Row="0"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MinValueTextBox"
                         Grid.Column="0"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         FontSize="12"
                         FontWeight="Bold"
                         FontFamily="Segoe UI"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         BorderThickness="0"
                         IsReadOnly="False"
                         Focusable="True"
                         IsHitTestVisible="True"
                         Padding="0"
                         Margin="2,0,0,0"
                         PreviewTextInput="ValueTextBox_PreviewTextInput"
                         GotKeyboardFocus="ValueTextBox_GotKeyboardFocus"
                         LostFocus="ValueTextBox_LostFocus"
                         TextChanged="ValueTextBox_TextChanged"
                         KeyDown="ValueTextBox_KeyDown" />

                <TextBlock Grid.Column="1"
                           Text="-"
                           FontSize="11"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <TextBox x:Name="MaxValueTextBox"
                         Grid.Column="2"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         FontSize="12"
                         FontWeight="Bold"
                         FontFamily="Segoe UI"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         BorderThickness="0"
                         IsReadOnly="False"
                         Focusable="True"
                         IsHitTestVisible="True"
                         Padding="0"
                         Margin="0,0,2,0"
                         PreviewTextInput="ValueTextBox_PreviewTextInput"
                         GotKeyboardFocus="ValueTextBox_GotKeyboardFocus"
                         LostFocus="ValueTextBox_LostFocus"
                         TextChanged="ValueTextBox_TextChanged"
                         KeyDown="ValueTextBox_KeyDown" />
            </Grid>

            <Border x:Name="Divider"
                    Grid.Row="1"
                    Height="1"
                    Margin="9,0,9,0" />

            <TextBlock x:Name="UnitTextBlock"
                       Grid.Row="2"
                       FontSize="10"
                       FontFamily="Segoe UI"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <Grid x:Name="RandomUnitPanel"
                  Grid.Row="2"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="MinUnitTextBlock"
                           Grid.Column="0"
                           FontSize="10"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text=" "
                           FontSize="10" />

                <TextBlock x:Name="MaxUnitTextBlock"
                           Grid.Column="2"
                           FontSize="10"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</local:NodeBase>
