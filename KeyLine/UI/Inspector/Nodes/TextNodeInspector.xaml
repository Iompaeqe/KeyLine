<UserControl x:Class="KeyLine.UI.Inspector.Nodes.TextNodeInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:KeyLine.UI">

    <Border Background="{StaticResource Surface}">
        <StackPanel x:Name="RootPanel"
                    Margin="0,2,0,0"
                    ToolTip="{x:Static ui:TooltipNotes.TextNodeValue}">

            <TextBlock Text="Text"
                       Style="{DynamicResource InspectorLabel}"
                       Margin="0,0,0,5" />

            <TextBox x:Name="TextEditor"
                     Height="58"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     ToolTip="{x:Static ui:TooltipNotes.TextNodeEdit}" />
        </StackPanel>
    </Border>
</UserControl>