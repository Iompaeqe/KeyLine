<UserControl x:Class="KeyLine.UI.MainWindow.Controls.TimelineAddMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="AddMenuButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PrimaryAddMenuButton" TargetType="Button" BasedOn="{StaticResource AddMenuButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,2,2,4" />
            <Setter Property="Background" Value="#102033" />
            <Setter Property="BorderBrush" Value="#2C4A6D" />
            <Setter Property="Foreground" Value="#DDEBFF" />
        </Style>

        <Style x:Key="QuickAddMenuButton" TargetType="Button" BasedOn="{StaticResource AddMenuButton}">
            <Setter Property="Background" Value="#102033" />
            <Setter Property="BorderBrush" Value="#2C4A6D" />
            <Setter Property="Foreground" Value="#DDEBFF" />
        </Style>

        <Style x:Key="BlockAddMenuButton" TargetType="Button" BasedOn="{StaticResource AddMenuButton}">
            <Setter Property="Background" Value="#221936" />
            <Setter Property="BorderBrush" Value="#5B3A88" />
            <Setter Property="Foreground" Value="#E9D5FF" />
        </Style>

        <Style x:Key="MouseAddMenuButton" TargetType="Button" BasedOn="{StaticResource AddMenuButton}">
            <Setter Property="Background" Value="#12302F" />
            <Setter Property="BorderBrush" Value="#1E7770" />
            <Setter Property="Foreground" Value="#CCFBF1" />
        </Style>

        <Style x:Key="SystemAddMenuButton" TargetType="Button" BasedOn="{StaticResource AddMenuButton}">
            <Setter Property="Background" Value="#172033" />
            <Setter Property="BorderBrush" Value="#52627A" />
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>

        <Style x:Key="ExperimentalAddMenuButton" TargetType="Button" BasedOn="{StaticResource AddMenuButton}">
            <Setter Property="Background" Value="#3A0A25" />
            <Setter Property="BorderBrush" Value="#BE185D" />
            <Setter Property="Foreground" Value="#FCE7F3" />
        </Style>

        <Style x:Key="AddMenuExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,3,2,0" />
        </Style>
    </UserControl.Resources>

    <Popup x:Name="AddPopup"
           Placement="Top"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Fade">
        <Border CornerRadius="12"
                Background="#08111F"
                BorderBrush="#263A55"
                BorderThickness="1"
                Padding="6"
                Margin="0,0,0,8"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="2"
                                  Direction="270"
                                  Opacity="0.38"
                                  Color="#000000" />
            </Border.Effect>

            <StackPanel Width="196">
                <Button x:Name="RecordMenuButton"
                        Content="Record input"
                        Style="{StaticResource PrimaryAddMenuButton}"
                        Click="RecordMenuButton_Click" />

                <UniformGrid Columns="2" Margin="0,0,0,2">
                    <Button Content="Delay"
                            Style="{StaticResource QuickAddMenuButton}"
                            Click="DelayMenuButton_Click" />

                    <Button Content="Random"
                            Style="{StaticResource QuickAddMenuButton}"
                            ToolTip="Random delay"
                            Click="RandomDelayMenuButton_Click" />

                    <Button x:Name="TextMenuButton"
                            Content="Text"
                            Style="{StaticResource QuickAddMenuButton}"
                            ToolTip="Add text"
                            Click="TextMenuButton_Click" />

                    <Button x:Name="RepeatBlockMenuButton"
                            Content="Repeat"
                            Style="{StaticResource BlockAddMenuButton}"
                            ToolTip="Repeat block"
                            Click="RepeatBlockMenuButton_Click" />

                    <Button x:Name="ConditionBlockMenuButton"
                            Content="Condition"
                            Style="{StaticResource BlockAddMenuButton}"
                            ToolTip="Condition block"
                            Click="ConditionBlockMenuButton_Click" />
                </UniformGrid>

                <Expander Header="Mouse" Style="{StaticResource AddMenuExpander}">
                    <UniformGrid Columns="2" Margin="0,4,0,0">
                        <Button x:Name="CursorMoveMenuButton"
                                Content="Cursor"
                                Style="{StaticResource MouseAddMenuButton}"
                                ToolTip="Cursor move"
                                Click="CursorMoveMenuButton_Click" />

                        <Button Content="Scroll Up"
                                Style="{StaticResource MouseAddMenuButton}"
                                Click="MouseScrollUpMenuButton_Click" />

                        <Button Content="Scroll Down"
                                Style="{StaticResource MouseAddMenuButton}"
                                Click="MouseScrollDownMenuButton_Click" />

                        <Button Content="Scroll Left"
                                Style="{StaticResource MouseAddMenuButton}"
                                Click="MouseScrollLeftMenuButton_Click" />

                        <Button Content="Scroll Right"
                                Style="{StaticResource MouseAddMenuButton}"
                                Click="MouseScrollRightMenuButton_Click" />
                    </UniformGrid>
                </Expander>

                <Expander x:Name="SystemAddMenuExpander"
                          Header="System"
                          Style="{StaticResource AddMenuExpander}">
                    <UniformGrid Columns="2" Margin="0,4,0,0">
                        <Button x:Name="SystemOpenLaunchMenuButton"
                                Content="Open"
                                Style="{StaticResource SystemAddMenuButton}"
                                ToolTip="Open/Launch"
                                Click="SystemOpenLaunchMenuButton_Click" />

                        <Button x:Name="SystemVolumeControlMenuButton"
                                Content="Volume"
                                Style="{StaticResource SystemAddMenuButton}"
                                ToolTip="Volume control"
                                Click="SystemVolumeControlMenuButton_Click" />

                        <Button x:Name="SystemWaitUntilWindowOpensMenuButton"
                                Content="Wait Window"
                                Style="{StaticResource SystemAddMenuButton}"
                                ToolTip="Wait until window opens"
                                Click="SystemWaitUntilWindowOpensMenuButton_Click" />

                        <Button x:Name="SystemFocusWindowMenuButton"
                                Content="Focus"
                                Style="{StaticResource SystemAddMenuButton}"
                                ToolTip="Focus window"
                                Click="SystemFocusWindowMenuButton_Click" />

                        <Button x:Name="SystemSelectTargetWindowMenuButton"
                                Content="Set Target"
                                Style="{StaticResource SystemAddMenuButton}"
                                ToolTip="Set target window"
                                Click="SystemSelectTargetWindowMenuButton_Click" />
                    </UniformGrid>
                </Expander>

                <Expander x:Name="ExperimentalAddMenuExpander"
                          Header="Experimental"
                          Style="{StaticResource AddMenuExpander}">
                    <UniformGrid Columns="2" Margin="0,4,0,0">
                        <Button x:Name="MouseDownMenuButton"
                                Content="BG Down"
                                Style="{StaticResource ExperimentalAddMenuButton}"
                                ToolTip="Background mouse down"
                                Click="MouseDownMenuButton_Click" />

                        <Button x:Name="MouseUpMenuButton"
                                Content="BG Up"
                                Style="{StaticResource ExperimentalAddMenuButton}"
                                ToolTip="Background mouse up"
                                Click="MouseUpMenuButton_Click" />

                        <Button x:Name="MouseClickMenuButton"
                                Content="BG Click"
                                Style="{StaticResource ExperimentalAddMenuButton}"
                                ToolTip="Background mouse click"
                                Click="MouseClickMenuButton_Click" />
                    </UniformGrid>
                </Expander>
            </StackPanel>
        </Border>
    </Popup>
</UserControl>
