<UserControl x:Class="KeyLine.UI.MainWindow.Controls.MacroOptionsPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:KeyLine.UI"
             xmlns:entryBlocks="clr-namespace:KeyLine.UI.Common.EntryBlocks">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Common/Styles/ControlPreviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Border Style="{DynamicResource OptionsPanelBorder}">
        <StackPanel>
            <Grid Style="{DynamicResource OptionsHeaderGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">

                    <TextBlock Text="OPTIONS"
                               Style="{DynamicResource Cap}"
                               Margin="0" />

                    <entryBlocks:OptionsPillBlock x:Name="ShortcutPill"
                                                  Text="no shortcut"
                                                  ToolTip="{x:Static ui:TooltipNotes.MacroShortcutCapture}"
                                                  Focusable="True" />

                    <entryBlocks:OptionsPillBlock x:Name="ShortcutTogglePill"
                                                  Text="enabled"
                                                  ToolTip="{x:Static ui:TooltipNotes.MacroShortcutToggle}" />

                    <entryBlocks:OptionsPillBlock x:Name="ShortcutRemapPill"
                                                  Text="Remap off"
                                                  ToolTip="{x:Static ui:TooltipNotes.MacroShortcutRemap}" />
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,-5">

                    <TextBlock Text="Loop Mode"
                               Style="{StaticResource Dim}"
                               Margin="0,0,6,0">

                        <TextBlock.ToolTip>
                            <TextBlock>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopMode}"/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopModeAsync}"/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopModeSync}"/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopModeCycle}"/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopModeChain}"/>
                            </TextBlock>
                        </TextBlock.ToolTip>
                    </TextBlock>

                    <ComboBox x:Name="LoopModeComboBox"
                              Width="82"
                              Height="22">
                        <ComboBox.ToolTip>
                            <TextBlock>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopMode}"/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopModeAsync}"/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopModeSync}"/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopModeCycle}"/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopModeChain}"/>
                            </TextBlock>
                        </ComboBox.ToolTip>
                    </ComboBox>

                    <entryBlocks:OptionsPillBlock x:Name="HooksPill"
                                                  Text="Hooks"
                                                  Margin="6,0,0,0"
                                                  ToolTip="Macro Hooks: optional Start/End timelines that wrap macro execution." />

                    <Popup x:Name="HooksPopup"
                           PlacementTarget="{Binding ElementName=HooksPill}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           HorizontalOffset="0"
                           VerticalOffset="4">
                        <Border Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" Color="#000000" />
                            </Border.Effect>
                            <StackPanel x:Name="HooksPopupRows" MinWidth="120">
                                <TextBlock Text="MACRO HOOKS"
                                           Style="{DynamicResource Cap}"
                                           Margin="0,0,0,6" />
                                <CheckBox x:Name="StartHookCheckBox"
                                          Content="Start"
                                          Margin="0,0,0,4"
                                          ToolTip="Run the Start timeline before the macro body." />
                                <CheckBox x:Name="EndHookCheckBox"
                                          Content="End"
                                          ToolTip="Run the End timeline after the macro body (skipped on hard stops)." />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>

