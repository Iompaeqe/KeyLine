<Window x:Class="KeySpammer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacroSpammer"
        Width="900" Height="420"
        MinWidth="720" MinHeight="360"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Focusable="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#10151D" />
        <SolidColorBrush x:Key="Surface" Color="#151C27" />
        <SolidColorBrush x:Key="Card" Color="#182131" />
        <SolidColorBrush x:Key="Border" Color="#2A3547" />
        <SolidColorBrush x:Key="Text" Color="#EEF4FA" />
        <SolidColorBrush x:Key="Muted" Color="#8EA0B6" />
        <SolidColorBrush x:Key="Cyan" Color="#38BDF8" />
        <SolidColorBrush x:Key="Purple" Color="#A78BFA" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>

        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="#E5EDF7" />
            <Setter Property="Background" Value="#1A2433" />
            <Setter Property="BorderBrush" Value="#354258" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter TargetName="B" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#111827" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="#2A3547" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#38BDF8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="14" Height="14" CornerRadius="4"
                                    Background="#111827" BorderBrush="#3A4658" BorderThickness="1"
                                    Margin="0,0,6,0">
                                <Path x:Name="Tick" Visibility="Collapsed"
                                      Stroke="#38BDF8" StrokeThickness="2"
                                      Data="M 2 7 L 5.5 10.5 L 12 4" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#162235" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#38BDF8" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#101827"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
        </Style>

        <Style TargetType="{x:Type Thumb}">
            <Setter Property="Background" Value="#64748B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                MinWidth="36"
                                MinHeight="8"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#243244" />
                                <Setter Property="Foreground" Value="#E6F6FF" />
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E3A5F" />
                                <Setter Property="Foreground" Value="#BDEBFF" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#3D5470" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Width" Value="260" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="#111827" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="9,0,7,0" />
            <Setter Property="MaxDropDownHeight" Value="240" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid x:Name="Root"
                              SnapsToDevicePixels="True">

                            <!-- Closed button -->
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen,
                                                      RelativeSource={RelativeSource TemplatedParent},
                                                      Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="ButtonBorder"
                                                Height="{TemplateBinding Height}"
                                                CornerRadius="7"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid Margin="9,0,7,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="18" />
                                                </Grid.ColumnDefinitions>

                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="0,0,6,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True" />

                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4.5 5 L 9 0"
                                                      Stroke="#7DD3FC"
                                                      StrokeThickness="1.6"
                                                      StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1A2332" />
                                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#475569" />
                                            </Trigger>

                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#182A3D" />
                                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#38BDF8" />
                                            </Trigger>

                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>

                                <ToggleButton.Background>
                                    <TemplateBinding Property="Background" />
                                </ToggleButton.Background>

                                <ToggleButton.BorderBrush>
                                    <TemplateBinding Property="BorderBrush" />
                                </ToggleButton.BorderBrush>

                                <ToggleButton.BorderThickness>
                                    <TemplateBinding Property="BorderThickness" />
                                </ToggleButton.BorderThickness>

                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </ToggleButton>

                            <!-- Dropdown -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">

                                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0"
                                        CornerRadius="8"
                                        Background="#111827"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24"
                                                          ShadowDepth="0"
                                                          Opacity="0.75"
                                                          Color="#000000" />
                                    </Border.Effect>

                                    <ScrollViewer CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  Padding="4">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup" Property="MinHeight" Value="40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Margin="8"
            CornerRadius="14"
            Background="{StaticResource Bg}"
            BorderBrush="#2A3547"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.45"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="96" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <!-- ── Title bar ───────────────────────────────────── -->
            <Grid Grid.Row="0"
                  Margin="14,0"
                  Background="Transparent"
                  PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Bar-chart logo mark -->
                    <Canvas Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Rectangle Canvas.Left="0" Canvas.Top="8" Width="4" Height="10" Fill="#0EA5C9" RadiusX="1" RadiusY="1" />
                        <Rectangle Canvas.Left="5" Canvas.Top="3" Width="4" Height="15" Fill="#2563EB" RadiusX="1" RadiusY="1" />
                        <Rectangle Canvas.Left="10" Canvas.Top="11" Width="4" Height="7" Fill="#7C3AED" RadiusX="1" RadiusY="1" />
                        <Rectangle Canvas.Left="15" Canvas.Top="5" Width="3" Height="13" Fill="#0EA5C9" RadiusX="1" RadiusY="1" Opacity="0.5" />
                    </Canvas>
                    <TextBlock Text="MacroSpammer" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  macro recorder" FontSize="11" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="—" Width="30" MinWidth="30" Height="22"
                            Background="Transparent" BorderBrush="Transparent"
                            Foreground="{StaticResource Muted}" FontSize="13"
                            Click="MinimizeButton_Click" />
                    <Button Content="✕" Width="30" MinWidth="30" Height="22"
                            Background="Transparent" BorderBrush="Transparent"
                            Foreground="{StaticResource Muted}" FontSize="11"
                            Click="CloseButton_Click" />
                </StackPanel>
                <Border Height="1" VerticalAlignment="Bottom" Margin="-14,0"
                        Background="#263244" />
            </Grid>

            <!-- ── Config strip ────────────────────────────────── -->
            <Grid Grid.Row="1" Margin="14,8,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Window selector -->
                <Grid Grid.Column="0"
                      Width="400"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="16" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="TARGET WINDOW"
                               Style="{StaticResource Cap}" />

                    <ComboBox x:Name="WindowComboBox"
                              Grid.Row="1"
                              Width="400"
                              DropDownOpened="WindowComboBox_DropDownOpened"
                              SelectionChanged="WindowComboBox_SelectionChanged" />

                    <ComboBox x:Name="HandleComboBox"
                              Grid.Row="3"
                              Width="400"
                              Visibility="Collapsed" />
                </Grid>

                <Border Grid.Column="2"
                        Width="280"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        CornerRadius="8"
                        Background="{StaticResource Card}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        Padding="13,8">
                    <StackPanel>
                        <TextBlock Text="OPTIONS" Style="{StaticResource Cap}" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="UseStandardDelayCheckBox"
                                      Content="Std delay"
                                      Checked="RefreshTimeline"
                                      Unchecked="RefreshTimeline"
                                      Margin="0,0,14,0" />

                            <TextBlock Text="ms"
                                       Style="{StaticResource Dim}"
                                       Margin="0,0,5,0" />

                            <TextBox x:Name="StandardDelayTextBox"
                                     Text="50"
                                     Width="50" />

                            <Border x:Name="ShowKeyUpDownCheckSeparator"
                                    Width="1"
                                    Background="#162035"
                                    Margin="14,0"
                                    Visibility="{Binding ElementName=ShowKeyUpDownCheckBox, Path=Visibility}" />

                            <CheckBox x:Name="ShowKeyUpDownCheckBox"
                                      Margin="0,0,10,0"
                                      Content="Show ↑↓"
                                      IsChecked="True"
                                      Checked="RefreshTimeline"
                                      Unchecked="RefreshTimeline" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Timeline ────────────────────────────────────── -->
            <Border Grid.Row="2" Margin="14,0,14,6" CornerRadius="10"
                    Background="#0F141D" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="12,5,12,0">
                        <TextBlock Text="TIMELINE" Style="{StaticResource Cap}"
                                   Margin="0" DockPanel.Dock="Left" />
                        <TextBlock Text="drag to reorder  ·  right-click text to edit"
                                   Style="{StaticResource Dim}" FontSize="10"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="TimelineScrollViewer"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      Padding="10,0,10,16"
                                      Background="Transparent"
                                      Loaded="TimelineScrollViewer_Loaded"
                                      ScrollChanged="TimelineScrollViewer_ScrollChanged"
                                      SizeChanged="TimelineScrollViewer_SizeChanged"
                                      PreviewMouseLeftButtonDown="TimelineScrollViewer_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="TimelineScrollViewer_PreviewMouseMove"
                                      PreviewMouseLeftButtonUp="TimelineScrollViewer_PreviewMouseLeftButtonUp"
                                      MouseLeave="TimelineScrollViewer_MouseLeave">

                            <StackPanel x:Name="TimelinePanel"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Background="Transparent"/>
                        </ScrollViewer>

                        <!-- Fake non-clickable scroll indicator -->
                        <Canvas x:Name="TimelineScrollIndicator"
                                Height="10"
                                VerticalAlignment="Bottom"
                                Margin="14,0,14,5"
                                IsHitTestVisible="False">

                            <Border x:Name="TimelineScrollTrack"
                                    Canvas.Left="0"
                                    Canvas.Top="3"
                                    Height="4"
                                    CornerRadius="2"
                                    Background="#334155"
                                    Opacity="0.55"/>

                            <Border x:Name="TimelineScrollThumb"
                                    Canvas.Left="0"
                                    Canvas.Top="3"
                                    Height="4"
                                    CornerRadius="2"
                                    Background="#94A3B8"
                                    Opacity="0.95"/>
                        </Canvas>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── Control bar ─────────────────────────────────── -->
            <Border Grid.Row="3" Margin="14,0,14,6" Padding="12,0" CornerRadius="10"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="102" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="AddButton" Content="＋  Add" Width="82"
                            Background="#123A5A" BorderBrush="#256D9D"
                            Foreground="#BAE6FD" Click="AddButton_Click" />

                    <TextBlock x:Name="StatusText" Grid.Column="2"
                               Text="Stopped" Style="{StaticResource Dim}" />

                    <TextBlock Grid.Column="3" Text="Loops"
                               Style="{StaticResource Dim}" Margin="0,0,8,0" />
                    <TextBox x:Name="LoopCountTextBox" Grid.Column="4" Text="0" />

                    <Button x:Name="ClearButton" Grid.Column="6" Content="Clear" Width="66"
                            Click="ClearButton_Click" />

                    <Grid Grid.Column="8">
                        <Button x:Name="StartStopButton" Content="▶  Start"
                                Background="#31205F" BorderBrush="#6D4AFF"
                                Foreground="#DDD6FE" Click="StartStopButton_Click" />
                        <Button x:Name="RecordStopButton" Content="◼  Stop Rec"
                                Background="#2A0808" BorderBrush="#7F1D1D"
                                Foreground="#FCA5A5" Visibility="Collapsed"
                                Click="RecordStopButton_Click" />
                    </Grid>

                    <Popup x:Name="AddPopup"
                           PlacementTarget="{Binding ElementName=AddButton}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="#05080F" BorderBrush="#162035" BorderThickness="1"
                                CornerRadius="9" Padding="5" Margin="0,0,0,6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="0"
                                                  Opacity="0.8" Color="#000000" />
                            </Border.Effect>
                            <StackPanel Width="124">
                                <Button Content="Record keys" Height="28" Margin="0,0,0,4"
                                        Click="RecordMenuButton_Click" />
                                <Button Content="Add delay" Height="28" Margin="0,0,0,4"
                                        Click="DelayMenuButton_Click" />
                                <Button Content="Add text" Height="28"
                                        Click="TextMenuButton_Click" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- ── Footer ──────────────────────────────────────── -->
            <DockPanel Grid.Row="4" Margin="16,0,16,0" VerticalAlignment="Center">
                <Ellipse Width="5" Height="5" Fill="#059669"
                         Margin="0,0,5,0" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBlock Text="Ready" Foreground="#059669" FontSize="11"
                           DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBlock Text="Delete = remove selected  ·  Esc = stop recording"
                           Style="{StaticResource Dim}" FontSize="10" HorizontalAlignment="Right" />
            </DockPanel>
        </Grid>
    </Border>
</Window>