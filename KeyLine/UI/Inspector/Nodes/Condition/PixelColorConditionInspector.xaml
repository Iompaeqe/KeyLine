<UserControl x:Class="KeyLine.UI.Inspector.Nodes.PixelColorConditionInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:KeyLine.UI"
             xmlns:layout="clr-namespace:KeyLine.UI.Common.Layout"
             xmlns:entryBlocks="clr-namespace:KeyLine.UI.Common.EntryBlocks">

    <Border Background="{StaticResource Surface}">
        <StackPanel>
            <layout:InspectorRow x:Name="PositionRow"
                                 Label="Position"
                                 RowToolTip="{x:Static ui:TooltipNotes.ConditionPixelPosition}">
                <entryBlocks:MultiValueEntryBlock HorizontalAlignment="Right"
                                                  ToolTip="{x:Static ui:TooltipNotes.ConditionPixelPosition}" />
            </layout:InspectorRow>

            <layout:InspectorRow x:Name="ColorRow"
                                 Label="Color"
                                 RowToolTip="{x:Static ui:TooltipNotes.ConditionPixelColor}">
                <entryBlocks:MultiValueEntryBlock HorizontalAlignment="Right"
                                                  ToolTip="{x:Static ui:TooltipNotes.ConditionPixelColor}" />
            </layout:InspectorRow>

            <layout:InspectorRow x:Name="ToleranceRow"
                                 Label="Tolerance"
                                 RowToolTip="{x:Static ui:TooltipNotes.ConditionPixelTolerance}">
                <entryBlocks:NumberEntryBlock HorizontalAlignment="Right"
                                              ToolTip="{x:Static ui:TooltipNotes.ConditionPixelTolerance}" />
            </layout:InspectorRow>

            <Button x:Name="PickPixelButton"
                    Content="Pick Pixel"
                    Height="22"
                    Margin="0,2,0,4"
                    ToolTip="{x:Static ui:TooltipNotes.ConditionPixelPick}" />
        </StackPanel>
    </Border>
</UserControl>