<UserControl x:Class="MacroSpammer.UI.MainWindow.Controls.MacroOptionsPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MacroSpammer.UI"
             xmlns:entryBlocks="clr-namespace:MacroSpammer.UI.Common.EntryBlocks">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Common/Styles/ControlPreviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Border Style="{DynamicResource OptionsPanelBorder}">
        <StackPanel>
            <Grid Style="{DynamicResource OptionsHeaderGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">

                    <TextBlock Text="OPTIONS"
                               Style="{DynamicResource Cap}"
                               Margin="0" />

                    <entryBlocks:OptionsPillBlock x:Name="ShortcutPill"
                                                  Text="no shortcut"
                                                  ToolTip="{x:Static ui:TooltipNotes.MacroShortcutCapture}"
                                                  Focusable="True" />

                    <entryBlocks:OptionsPillBlock x:Name="ShortcutTogglePill"
                                                  Text="on"
                                                  ToolTip="{x:Static ui:TooltipNotes.MacroShortcutToggle}" />
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,-5">

                    <TextBlock Text="Loop Mode"
                               Style="{StaticResource Dim}"
                               Margin="0,0,6,0">

                        <TextBlock.ToolTip>
                            <TextBlock>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopMode}"/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopModeAsync}"/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopModeSync}"/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopModeCycle}"/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopModeChain}"/>
                            </TextBlock>
                        </TextBlock.ToolTip>
                    </TextBlock>

                    <ComboBox x:Name="LoopModeComboBox"
                              Width="82"
                              Height="22">
                        <ComboBox.ToolTip>
                            <TextBlock>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopMode}"/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopModeAsync}"/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopModeSync}"/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopModeCycle}"/>
                                <LineBreak/>
                                <Run Text="{x:Static ui:TooltipNotes.MacroLoopModeChain}"/>
                            </TextBlock>
                        </ComboBox.ToolTip>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>

