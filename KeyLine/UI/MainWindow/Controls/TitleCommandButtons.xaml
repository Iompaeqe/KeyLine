<UserControl x:Class="KeyLine.UI.MainWindow.Controls.TitleCommandButtons"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:KeyLine.UI"
             MinWidth="130"
             Height="36">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Common/Styles/ControlPreviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource Bg}"
            Padding="4,0">

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

            <Button x:Name="ToggleRightPanelButton"
                    Content="◫"
                    Style="{StaticResource TitleGlyphButton}"
                    ToolTip="{x:Static ui:TooltipNotes.ToggleInspector}" />

            <Button x:Name="SettingsButton"
                    Content="&#x2699;"
                    Style="{StaticResource TitleGlyphButton}"
                    ToolTip="{x:Static ui:TooltipNotes.OpenSettings}" />

            <Button x:Name="MinimizeButton"
                    Content="─"
                    Style="{StaticResource TitleGlyphButton}" />

            <Button x:Name="CloseWindowButton"
                    Content="×"
                    Style="{StaticResource TitleCloseGlyphButton}" />

        </StackPanel>
    </Border>
</UserControl>