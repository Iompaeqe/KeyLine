<UserControl x:Class="KeyLine.UI.MainWindow.Controls.ProfileDropdownBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="36"
             MinWidth="112"
             VerticalAlignment="Center">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Common/Styles/ControlPreviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource Bg}"
            Padding="4,0">
        <Grid>
            <Button x:Name="ProfileSelectorButton"
                    Height="24"
                    MinWidth="112"
                    MaxWidth="142"
                    Padding="9,0,7,1"
                    Background="#111827"
                    BorderBrush="#334155"
                    Foreground="{StaticResource Text}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="10" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SelectedProfileTextBlock"
                               Text="No Profile"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />

                    <Path Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0"
                          Stroke="#7DD3FC"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Popup x:Name="ProfilePopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=ProfileSelectorButton}"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Width="150"
                        MaxHeight="254"
                        Margin="0,5,0,0"
                        CornerRadius="10"
                        Background="#111827"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Padding="6"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.75"
                                          Color="#000000" />
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid MaxHeight="206"
                              ClipToBounds="True">
                            <ScrollViewer x:Name="ProfileScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          Background="Transparent">
                                <StackPanel x:Name="ProfileRowsPanel"
                                            Orientation="Vertical"
                                            Background="Transparent" />
                            </ScrollViewer>

                            <Canvas x:Name="ProfileDragOverlay"
                                    IsHitTestVisible="False"
                                    ClipToBounds="True" />
                        </Grid>

                        <Button x:Name="AddProfileButton"
                                Grid.Row="1"
                                Content="New Profile"
                                Height="28"
                                MinWidth="0"
                                Margin="0,6,0,0"
                                Padding="0"
                                Background="#123A5A"
                                BorderBrush="#256D9D"
                                Foreground="#BAE6FD"
                                FontSize="12"
                                FontWeight="Bold" />
                    </Grid>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>