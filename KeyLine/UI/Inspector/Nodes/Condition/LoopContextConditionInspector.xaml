<UserControl x:Class="KeyLine.UI.Inspector.Nodes.LoopContextConditionInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:KeyLine.UI"
             xmlns:layout="clr-namespace:KeyLine.UI.Common.Layout"
             xmlns:entryBlocks="clr-namespace:KeyLine.UI.Common.EntryBlocks">

    <Border Background="{StaticResource Surface}">
        <StackPanel>
            <layout:InspectorRow x:Name="ModeRow"
                                 Label="Mode"
                                 RowToolTip="{x:Static ui:TooltipNotes.ConditionLoopContext}">
                <ComboBox Width="176"
                          Height="24"
                          Padding="-5,0,-5,0"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          ToolTip="{x:Static ui:TooltipNotes.ConditionLoopContext}" />
            </layout:InspectorRow>

            <layout:InspectorRow x:Name="IntervalRow"
                                 Label="Every"
                                 RowToolTip="{x:Static ui:TooltipNotes.ConditionLoopInterval}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <entryBlocks:NumberEntryBlock ToolTip="{x:Static ui:TooltipNotes.ConditionLoopInterval}" />

                    <TextBlock Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Style="{DynamicResource InspectorValue}" />
                </StackPanel>
            </layout:InspectorRow>
        </StackPanel>
    </Border>
</UserControl>