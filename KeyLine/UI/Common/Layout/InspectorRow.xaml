<UserControl x:Class="KeyLine.UI.Common.Layout.InspectorRow"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="22"
             Margin="{Binding RowMargin, ElementName=Root}"
             ToolTip="{Binding RowToolTip, ElementName=Root}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding Label, ElementName=Root}"
                   Style="{DynamicResource InspectorLabel}"
                   ToolTip="{Binding RowToolTip, ElementName=Root}" />

        <ContentPresenter Grid.Column="1"
                          Content="{Binding RowContent, ElementName=Root}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center" />
    </Grid>
</UserControl>