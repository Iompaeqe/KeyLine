<UserControl x:Class="KeyLine.UI.Inspector.Nodes.SystemVolumeNodeInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:KeyLine.UI.Common.Layout"
             xmlns:entryBlocks="clr-namespace:KeyLine.UI.Common.EntryBlocks">

    <Border Background="{StaticResource Surface}">
        <StackPanel>
            <layout:InspectorRow x:Name="SummaryRow"
                                 Label="Summary">
                <TextBlock TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="190"
                           Style="{DynamicResource InspectorValue}" />
            </layout:InspectorRow>

            <layout:InspectorRow x:Name="ActionRow"
                                 Label="Action"
                                 RowToolTip="Choose the volume operation to run.">
                <ComboBox Width="120"
                          Height="24"
                          Padding="-5,0,-5,0"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          ToolTip="Choose the volume operation to run." />
            </layout:InspectorRow>

            <layout:InspectorRow x:Name="VolumeRow"
                                 Label="Volume"
                                 RowToolTip="Set the system output volume percentage.">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <entryBlocks:NumberEntryBlock ToolTip="Set the system output volume percentage." />

                    <TextBlock Text="%"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Style="{DynamicResource InspectorValue}" />
                </StackPanel>
            </layout:InspectorRow>
        </StackPanel>
    </Border>
</UserControl>