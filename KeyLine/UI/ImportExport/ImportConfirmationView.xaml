<UserControl x:Class="KeyLine.ImportConfirmationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border Width="460"
            Height="390"
            CornerRadius="12"
            Background="#121A27"
            BorderBrush="#2A3B55"
            BorderThickness="1"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleTextBlock"
                       Text="Confirm import"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#E5EEF8"
                       Margin="0,0,0,8" />

            <Border x:Name="WarningBorder"
                    Grid.Row="1"
                    CornerRadius="8"
                    Background="#2A0808"
                    BorderBrush="#7F1D1D"
                    BorderThickness="1"
                    Padding="9,6"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
                <TextBlock x:Name="WarningTextBlock"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Foreground="#FCA5A5" />
            </Border>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          Background="#0B1220"
                          BorderBrush="#2A3B55"
                          BorderThickness="1"
                          Padding="10">
                <StackPanel x:Name="ContentPanel" />
            </ScrollViewer>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="Cancel"
                        Width="82"
                        Height="26"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click" />
                <Button x:Name="ConfirmButton"
                        Content="Import"
                        Width="92"
                        Height="26"
                        Background="#123A5A"
                        BorderBrush="#256D9D"
                        Foreground="#BAE6FD"
                        Click="ConfirmButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
